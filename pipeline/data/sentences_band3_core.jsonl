{"id": "T0969", "ru": "Он сидит напротив меня.", "en": "He's sitting across from me.", "ja": "彼は僕の向かいに座ってる。", "lemmas": ["он", "сидеть", "напротив", "я"], "target_lemma": "напротив", "difficulty": 2, "kind": "sentence", "note": "напротив + 生格 → напротив меня"}
{"id": "T0972", "ru": "Свет идёт сверху.", "en": "The light comes from above.", "ja": "光が上から差してる。", "lemmas": ["свет", "идти", "сверху"], "target_lemma": "сверху", "difficulty": 1, "kind": "sentence"}
