{
  "name": "lingogate-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LingoGate PWA — 脱スマホ中毒×ロシア語フラッシュカードのブラウザ版（高速反復テスト用）",
  "scripts": {
    "gen:content": "node scripts/build-content.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "prebuild": "npm run gen:content && npm run gen:icons",
    "predev": "npm run gen:content && npm run gen:icons",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
